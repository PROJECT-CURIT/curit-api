NODE_ENV=development
HOST=0.0.0.0
PORT=4100
# QR 웹과 앱 웹처럼 여러 클라이언트를 허용할 때 쉼표로 구분합니다.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8082,http://127.0.0.1:8082
PUBLIC_WEB_URL=http://localhost:5173

# 32자 이상의 무작위 값으로 교체하세요. 공개 저장소에 실제 값을 커밋하면 안 됩니다.
SESSION_SECRET=replace-with-at-least-32-random-characters

# demo는 실제 과금 없이 주문 흐름만 검증합니다. 운영에서는 toss로 전환해야 합니다.
PAYMENT_MODE=demo

# 비워 두면 메모리 기반 데모 저장소를 사용합니다. 운영에서는 Supabase/PostgreSQL URL을 입력합니다.
DATABASE_URL=

# Toss Payments v2 운영 전환 시 서버 환경변수로만 설정합니다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 토스 개발자센터 API 개별 키의 64자 보안 키입니다. 웹훅 서명 검증에 사용합니다.
TOSS_WEBHOOK_SECURITY_KEY=
# 운영 MID까지 교차 검증하려면 설정합니다.
TOSS_EXPECTED_MID=

# 지급대행은 별도 계약·판매자 본인확인(KYC) 완료 후에만 toss로 전환합니다.
PAYOUT_MODE=disabled
TOSS_PAYOUT_SECRET_KEY=
TOSS_PAYOUT_SECURITY_KEY=
# 스케줄러/운영 도구에서 푸시 영수증 확인·지급 실행 엔드포인트를 호출할 때 사용하는 무작위 비밀값입니다.
OPERATIONS_JOB_SECRET=
# 기존 배포 호환용 이름이며 OPERATIONS_JOB_SECRET 설정을 권장합니다.
PAYOUT_JOB_SECRET=
